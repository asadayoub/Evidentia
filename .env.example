# Evidentia local runtime template. This file is intentionally not usable as-is.
# Run `make local-init` to create an owner-readable `.env` with a random secret.

POSTGRES_PASSWORD=__GENERATE_WITH_MAKE_LOCAL_INIT__
POSTGRES_DB=evidentia
POSTGRES_USER=evidentia
EVIDENTIA_DATABASE_PORT=5432
EVIDENTIA_API_PORT=8000
EVIDENTIA_WEB_PORT=3000

# Native PostgreSQL application connection. Keep these aligned with the
# POSTGRES_* values until the optional hybrid profile is implemented.
EVIDENTIA_DATABASE__HOST=127.0.0.1
EVIDENTIA_DATABASE__PORT=5432
EVIDENTIA_DATABASE__NAME=evidentia
EVIDENTIA_DATABASE__USER=evidentia
EVIDENTIA_DATABASE__PASSWORD=__GENERATE_WITH_MAKE_LOCAL_INIT__
EVIDENTIA_DATABASE__CONNECT_TIMEOUT_SECONDS=5
EVIDENTIA_DATABASE__SSLMODE=prefer
EVIDENTIA_DATABASE__APPLICATION_NAME=evidentia

# Local bootstrap identity. The generated password is consumed only by the
# explicit identity initialization command and must not be committed.
EVIDENTIA_IDENTITY__BOOTSTRAP_LOGIN_IDENTIFIER=admin@localhost
EVIDENTIA_IDENTITY__BOOTSTRAP_DISPLAY_NAME="Local Administrator"
EVIDENTIA_IDENTITY__BOOTSTRAP_TENANT_SLUG=local
EVIDENTIA_IDENTITY__BOOTSTRAP_TENANT_NAME="Local Evidentia Workspace"
EVIDENTIA_IDENTITY__BOOTSTRAP_PASSWORD=__GENERATE_WITH_MAKE_LOCAL_INIT__

# Opaque server-side session policy. Production must supply a high-entropy
# secret through its secret manager and must enable secure cookies.
EVIDENTIA_SESSION__SECRET=__GENERATE_WITH_MAKE_LOCAL_INIT__
EVIDENTIA_SESSION__IDLE_TIMEOUT_SECONDS=1800
EVIDENTIA_SESSION__ABSOLUTE_TIMEOUT_SECONDS=43200
EVIDENTIA_SESSION__COOKIE_NAME=evidentia_session
EVIDENTIA_SESSION__COOKIE_SECURE=false
EVIDENTIA_SESSION__COOKIE_SAMESITE=lax
